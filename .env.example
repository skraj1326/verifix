# VerifiX AI - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=VerifiX AI
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://verifix:verifix@localhost:5432/verifix
DATABASE_SYNC_URL=postgresql://verifix:verifix@localhost:5432/verifix

# Redis
REDIS_URL=redis://localhost:6379/0

# File Storage
STORAGE_ROOT=./storage
RTL_STORAGE=./storage/rtl
TEST_STORAGE=./storage/tests
LOG_STORAGE=./storage/logs
COVERAGE_STORAGE=./storage/coverage

# LLM Configuration
# Set LLM_API_KEY to enable AI features
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Simulation
VERILATOR_PATH=verilator
ICARUS_PATH=iverilog
SIMULATION_TIMEOUT=300
MAX_CONCURRENT_SIMS=4

# AI Agent
AI_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.6
AI_MAX_RETRIES=3

# Security
ENCRYPTION_KEY=
AUDIT_LOG_ENABLED=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2